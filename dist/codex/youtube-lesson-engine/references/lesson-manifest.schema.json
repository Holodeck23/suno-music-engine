{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson-manifest.schema.json",
  "title": "Lesson manifest",
  "description": "Structural contract for lesson-manifest.json. Structure, ordering and narration rules that a JSON Schema cannot express are enforced by scripts/validate-lesson-manifest.py; see references/script-and-retention-engine.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "bgm_track", "voice_id", "segments"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "bgm_track": {"type": "string", "minLength": 1},
    "voice_id": {"type": "string", "minLength": 1},
    "segments": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "narration", "visual_state", "bgm_mode", "visual_payload"],
      "properties": {
        "id": {"type": "string", "pattern": "^seg_[0-9]{2}_(hook|mechanism|proof|verdict)(_[a-z0-9]+)*$"},
        "narration": {"type": "string", "minLength": 1},
        "visual_state": {"enum": ["vibe_drop", "code_focus", "architecture_graph", "artifact_pan"]},
        "bgm_mode": {"enum": ["ducked", "full_swell"]},
        "visual_payload": {"$ref": "#/$defs/visual_payload"}
      }
    },
    "visual_payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {"type": "string", "minLength": 1},
        "code_snippet": {"type": "string", "minLength": 1},
        "diagram_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "highlight_triggers": {"type": "array", "items": {"$ref": "#/$defs/highlight_trigger"}}
      }
    },
    "highlight_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "action"],
      "properties": {
        "word": {"type": "string", "pattern": "^\\S+$"},
        "action": {
          "type": "string",
          "pattern": "^((reveal|highlight)_(line|node)_[1-9][0-9]*|show_headline|drop)$"
        }
      }
    }
  }
}
